        "        self.name = name\n",
        "        self.node_type = node_type  # 'model', 'rule', 'field', 'action'\n",
        "        self.payload = payload\n",
        "        self.hash = hashlib.sha256(f\"{name}:{payload}\".encode()).hexdigest()[:8]\n",
        "        self.connections = []\n",
        "\n",
        "class AetherRuntimeEngine:\n",
        "    \"\"\"Selve operativsystem-motoren som kjører uten tradisjonelle kompileringsbarrierer.\"\"\"\n",
