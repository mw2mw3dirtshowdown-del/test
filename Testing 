        "        print(\"\\n[PARSER] Tolker Nova-syntaks direkte til Aether-noder...\")\n",
        "        lines = [l.strip() for l in raw_nova_code.split('\\n') if l.strip()]\n",
        "\n",
        "        current_node = None\n",
        "        for line in lines:\n",
        "            if line.startswith(\"@model\"):\n",
        "                name = line.replace(\"@model\", \"\").strip()\n",
        "                current_node = AetherNode(name, \"model\", {})\n",
        "                self.memory_space[name] = current_node\n",
        "                print(f\" -> [MODELL] Instansiert levende struktur: {name}\")\n",
        "            elif line.startswith(\"@rule\"):\n",
